<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:Class="AveriStrap.UI.AppThemes.ResourceDictionaries.Dark">

    <SolidColorBrush x:Key="NormalDarkAndLightBackground"  Color="#01000000" />

    <!-- Negro morado -->
    <LinearGradientBrush x:Key="ApplicationBackgroundColor" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#E6050308" />
        <GradientStop Offset="1" Color="#E61E0B36" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="NotificationBackgroundColor"           Color="#1B1029" />

    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush"     Color="#0A0610" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="#160D24" />
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush"   Color="#1AA855F7" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush"           Color="#40A855F7" />
</ResourceDictionary>
