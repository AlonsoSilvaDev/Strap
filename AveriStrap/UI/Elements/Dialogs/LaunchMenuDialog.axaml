<base:AvaloniaWindow x:Class="AveriStrap.UI.Elements.Dialogs.LaunchMenuDialog"
                     xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:base="using:AveriStrap.UI.Elements.Base"
                     xmlns:controls="using:AveriStrap.UI.Elements.Controls"
                     xmlns:resources="using:AveriStrap.Localisation"
                     xmlns:models="using:AveriStrap.UI.ViewModels"
                     xmlns:vm="using:AveriStrap.UI.ViewModels.Dialogs"
                     xmlns:ic="clr-namespace:LucideAvalonia;assembly=LucideAvalonia"
                     xmlns:enums="using:AveriStrap.Enums"
                     x:DataType="vm:LaunchMenuViewModel"
                     Title="AveriStrap"
                     Width="420"
                     SizeToContent="Height"
                     CanResize="False"
                     WindowStartupLocation="CenterScreen">

    <Grid>
        <StackPanel Margin="32,0,32,32">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16" Margin="0,8,0,24">
                <Image Width="64" Height="64" Source="avares://AveriStrap/Resources/IconAveriStrap.png"
                       RenderOptions.BitmapInterpolationMode="HighQuality"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Name="LaunchTitle" Text="AveriStrap" FontSize="28" FontWeight="Bold" />
                    <TextBlock Text="{Binding Version}"
                               FontSize="13"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </StackPanel>

            <controls:IconButton Classes="DropDownButton"
                                 Margin="0,0,0,8"
                                 HorizontalAlignment="Stretch"
                                 Height="52"
                                 CornerRadius="8"
                                 FontWeight="SemiBold"
                                 FontSize="14"
                                 Command="{Binding LaunchCommand}"
                                 IconSize="24"
                                 Icon="{Binding LaunchButtonIcon}"
                                 Content="{Binding LaunchButtonText}"
                                 Padding="16,0">
                <controls:IconButton.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <MenuItem Header="{Binding PlayerMenuItemText}"
                                  Command="{Binding SetLaunchModeCommand}"
                                  CommandParameter="{x:Static enums:LaunchMode.Player}">
                            <MenuItem.Icon>
                                <ic:Lucide Icon="Gamepad2" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{x:Static resources:Strings.Common_Studio}"
                                  Command="{Binding SetLaunchModeCommand}"
                                  CommandParameter="{x:Static enums:LaunchMode.Studio}">
                            <MenuItem.Icon>
                                <ic:Lucide Icon="Wrench" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </MenuFlyout>
                </controls:IconButton.Flyout>
            </controls:IconButton>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <controls:IconButton
                    Grid.Column="0"
                    Icon="Settings"
                    Content="{x:Static resources:Strings.Common_Settings}"
                    CornerRadius="8"
                    BorderThickness="0"
                    Height="56"
                    Command="{Binding LaunchSettingsCommand}"
                    IconSize="24"
                    Padding="12,10" />

                <controls:IconButton
                    Grid.Column="1"
                    Icon="MessageCircleMore"
                    Content="Discord"
                    CornerRadius="8"
                    Height="56"
                    BorderThickness="0"
                    IconSize="24"
                    Command="{x:Static models:GlobalViewModel.OpenDiscordCommand}"
                    Padding="12,10" />
            </Grid>
        </StackPanel>
    </Grid>
</base:AvaloniaWindow>
