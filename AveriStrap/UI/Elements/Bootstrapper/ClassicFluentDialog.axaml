<base:AvaloniaDialogBase xmlns="https://github.com/avaloniaui"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:vm="using:AveriStrap.UI.ViewModels.Bootstrapper"
                         xmlns:base="using:AveriStrap.UI.Elements.Bootstrapper.Base"
                         xmlns:controls="using:AveriStrap.UI.Elements.Controls"
                         x:Class="AveriStrap.UI.Elements.Bootstrapper.ClassicFluentDialog"
                         x:DataType="vm:ClassicFluentDialogViewModel"
                         Width="420" Height="190"
                         CanResize="False"
                         Title="AveriStrap"
                         WindowStartupLocation="CenterScreen"
                         ExtendClientAreaToDecorationsHint="True"
                         ExtendClientAreaTitleBarHeightHint="-1">

    <Grid RowDefinitions="Auto, *, Auto">
        <controls:TitleBar Grid.Row="0"
                           Icon="{Binding Icon}"
                           Title="AveriStrap"
                           ShowMinimize="False"
                           ShowMaximize="False"
                           ShowClose="False"/>

        <Grid Grid.Row="1" Margin="16,0" VerticalAlignment="Center" ColumnDefinitions="Auto, *">
            <Image Grid.Column="0"
                   Width="48" Height="48"
                   VerticalAlignment="Top"
                   Source="{Binding Icon}"
                   RenderOptions.BitmapInterpolationMode="HighQuality" />

            <StackPanel Grid.Column="1" Margin="16,0,0,0">
                <TextBlock FontSize="20"
                           Text="{Binding Message}"
                           TextWrapping="Wrap"
                           Theme="{StaticResource BodyTextBlockStyle}" />

                <ProgressBar Margin="0,16,0,0"
                             IsIndeterminate="{Binding ProgressIndeterminate}"
                             Maximum="{Binding ProgressMaximum}"
                             Value="{Binding ProgressValue}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Padding="15">
            <Border.Background>
                <SolidColorBrush Color="{DynamicResource SolidBackgroundFillColorSecondary}"
                                 Opacity="{Binding FooterOpacity}" />
            </Border.Background>
            <Button Content="{Binding CancelButtonText}"
                    Width="120"
                    HorizontalAlignment="Right"
                    IsEnabled="{Binding CancelEnabled}"
                    Command="{Binding CancelInstallCommand}" />
        </Border>
    </Grid>
</base:AvaloniaDialogBase>
